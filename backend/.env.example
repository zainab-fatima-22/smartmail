# SmartMail backend — environment variables
# Copy this file to .env and adjust as needed. .env itself is gitignored
# and must never be committed — see the root .gitignore.
#
# Every value below has a sensible default in app/config.py, so running
# without a .env file at all works fine for local development. This file
# exists so you can override any of them (e.g. for Docker, or a stricter
# production CORS policy) without editing code.

# Where the trained model file lives. Only needed if you move it from the
# default location (ml/models/email_classifier.joblib relative to the
# project root).
# MODEL_PATH=/app/ml/models/email_classifier.joblib

# SQLAlchemy database URL. Defaults to a local SQLite file inside backend/.
# DATABASE_URL=sqlite:///./smartmail.db

# Comma-separated list of frontend origins allowed to call this API.
# In production, set this to your actual frontend domain(s) — never "*".
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum length (characters) accepted for a pasted email.
MAX_EMAIL_LENGTH=10000

# Maximum size (bytes) accepted for an uploaded .txt/.eml file. 2 MB default.
MAX_UPLOAD_SIZE_BYTES=2097152

# Confidence below this threshold is flagged as "low confidence" in the API
# response (0.0 - 1.0).
LOW_CONFIDENCE_THRESHOLD=0.6
